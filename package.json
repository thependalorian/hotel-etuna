{
  "name": "hotel-etuna",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/clean-dev-cache.mjs && next dev --webpack",
    "dev:fresh": "rm -rf .next && next dev --webpack",
    "dev:turbo": "node scripts/clean-dev-cache.mjs && next dev --turbopack",
    "build": "next build",
    "postinstall": "echo 'Run db:generate if needed'",
    "start": "next start",
    "lint": "eslint",
    "test:ci": "npm run test:db && npm run test:db:migrations && npm run validate:email-templates && npm run validate:document-wiring && npm test && vitest run --config vitest.smoke.config.ts",
    "verify:production": "npx tsc --noEmit && npm run test:ci && npm run build",
    "security:preflight": "tsx scripts/security/run-preflight.ts",
    "security:audit-report": "tsx scripts/security/capture-npm-audit.ts",
    "validate:audit-wave6": "tsx scripts/compliance/run-audit-validation.ts",
    "validate:soc2": "tsx scripts/compliance/run-validate-soc2.ts",
    "validate:policy-implementation": "tsx scripts/compliance/validate-policy-implementation.ts",
    "verify:pgaudit": "tsx scripts/compliance/verify-pgaudit.ts",
    "verify:pgaudit:strict": "tsx scripts/compliance/verify-pgaudit.ts --strict",
    "enable:pgaudit": "tsx scripts/compliance/enable-pgaudit.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:seed": "tsx scripts/seed-hotel-etuna.ts",
    "test:seed:partners": "tsx scripts/seed-partners.ts",
    "seed:partners": "tsx scripts/seed-partners.ts",
    "provision:hotel-team": "tsx scripts/provision-hotel-team.ts",
    "seed:introducers": "tsx scripts/seed-introducers.ts",
    "seed:menu-images": "tsx scripts/seed-menu-images.ts",
    "seed:menu-images:force": "tsx scripts/seed-menu-images.ts --force",
    "validate:menu-images": "tsx scripts/validate-menu-images.ts",
    "seed:menu-images:full": "tsx scripts/seed-menu-images.ts --force && tsx scripts/validate-menu-images.ts",
    "test:db": "tsx scripts/db/verify-db.ts",
    "test:db:rls": "tsx scripts/db/verify-tenant-rls.ts",
    "test:db:migrations": "tsx scripts/db/verify-neon-migrations.ts",
    "test:smoke": "npm run test:db && vitest run --config vitest.smoke.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:desktop": "playwright test --project=chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chrome",
    "test:e2e:tablet": "playwright test --project=tablet",
    "test:e2e:responsive": "playwright test e2e/responsive-layout.spec.ts",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:install:all": "playwright install",
    "test:all": "npm run test:ci",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:push:force": "yes '' | drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:types": "echo 'Use Drizzle: import from @/lib/db/schema-types or schema.ts ($inferSelect). No separate types file.'",
    "db:audit:neon": "tsx scripts/db/audit-neon-baseline.ts",
    "db:migrate:all": "tsx scripts/db/apply-all-missing-migrations.ts",
    "db:generate:all-sql": "tsx scripts/db/generate-all-migrations-sql.ts",
    "validate:email-templates": "tsx scripts/validate-sofia-email-templates.ts",
    "validate:document-wiring": "tsx scripts/validate-document-wiring.ts",
    "validate:adumo": "tsx scripts/validate-adumo-virtual.ts",
    "db:migrate:pending": "npm run db:migrate:all",
    "db:seed:loyalty-tiers": "tsx scripts/db/seed-loyalty-tiers.ts",
    "rag:seed": "tsx scripts/ingest-hotel-etuna-knowledge.ts",
    "rag:seed:dry": "tsx scripts/ingest-hotel-etuna-knowledge.ts --dry",
    "env:check": "node scripts/check-env-local.mjs",
    "env:sync": "node scripts/sync-env-local.mjs && node scripts/check-env-local.mjs",
    "env:push-vercel": "node scripts/push-env-to-vercel.mjs",
    "env:push-vercel:dry": "node scripts/push-env-to-vercel.mjs --dry-run",
    "env:push-vercel:new": "node scripts/push-env-to-vercel.mjs --new-only",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
