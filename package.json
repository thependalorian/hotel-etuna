    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.2",
    "@react-pdf/renderer": "^4.5.1",
    "@stackframe/stack": "^2.8.58",
    "@supabase/supabase-js": "^2.49.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/nodemailer": "^7.0.4",
    "@zxing/browser": "^0.2.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "daisyui": "^5.5.5",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "imapflow": "^1.2.6",
    "ioredis": "^5.4.2",
    "isomorphic-dompurify": "^3.10.0",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "mailparser": "^3.9.1",
    "next": "^16.0.0",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.11",
    "openai": "^6.35.0",
    "pg": "^8.16.3",
    "posthog-js": "^1.373.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.53.2",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/bcrypt": "^6.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "baseline-browser-mapping": "^2.9.14",
    "dompurify": "^3.4.1",
    "drizzle-kit": "^0.27.2",
    "eslint": "^9",
    "eslint-config-next": "16.0.4",
    "happy-dom": "^20.1.0",
    "posthog-node": "^5.34.2",
    "supabase": "^2.12.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "uuid": "^13.0.0",
    "vitest": "^4.0.16",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "fast-xml-parser": ">=5.7.0",
    "protobufjs": ">=7.5.5"
  }
}
