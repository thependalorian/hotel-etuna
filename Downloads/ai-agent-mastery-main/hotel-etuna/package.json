{
  "name": "buffr-host",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "echo 'Run db:generate if needed'",
    "start": "next start",
    "lint": "eslint",
    "verify:production": "npx tsc --noEmit && vitest run && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:seed": "tsx tests/seed/seed-data.ts",
    "test:seed:working": "tsx tests/seed/working-seed.ts",
    "seed:partners": "tsx scripts/seed-partners.ts",
    "test:api": "tsx scripts/test-api-crud-operations.ts",
    "test:api:crud": "tsx scripts/test-all-crud-operations.ts",
    "test:setup:restaurant": "tsx scripts/setup-test-restaurant.ts",
    "test:db": "tsx scripts/verify-db.ts",
    "test:db:rls": "tsx scripts/db/verify-tenant-rls.ts",
    "test:smoke": "npm run test:db && vitest run --config vitest.smoke.config.ts",
    "test:smoke:journeys": "tsx scripts/smoke-user-journeys.ts",
    "test:llm:keys": "bash scripts/test-llm-keys.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:all": "npm run test:db && npm test && vitest run --config vitest.smoke.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:push:force": "yes '' | drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "db:types": "echo 'After db:push, regenerate types via Supabase Dashboard/MCP/CLI → lib/db/database.types.ts'",
    "rag:seed": "tsx scripts/ingest-hotel-etuna-knowledge.ts",
    "rag:seed:dry": "tsx scripts/ingest-hotel-etuna-knowledge.ts --dry",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status"
  },
