# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# Playwright MCP / browser cache (if used locally)
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.key
*.p12
*.pfx
credentials.json
**/service-account*.json
**/secrets.json
*.secret
*.secrets

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & secrets — NEVER commit real values (see .env.example for templates)
.env
.env.local
.env.*.local
.env.vercel
.env.development
.env.production
.env.test
.env.backup*
.env.*.backup*
!.env.example

# vercel / deploy artifacts
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI (local)
supabase/.branches
supabase/.temp

# IDE / local agent (may contain tokens or paths)
.cursor/
.idea/
*.swp
*.swo

# SOC2 / compliance evidence exports (may contain PII)
compliance/evidence/
compliance/exports/
