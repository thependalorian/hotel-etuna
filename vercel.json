{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/email-inbox-monitor",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/booking-reminders",
      "schedule": "0 7 * * *",
      "description": "Pre-arrival reminders (check-in tomorrow)"
    },
    {
      "path": "/api/cron/uptime-monitor",
      "schedule": "* * * * *",
      "description": "PSD-12 uptime monitoring (every minute)"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}
