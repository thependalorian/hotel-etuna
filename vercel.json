{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/email-inbox-monitor",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/booking-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/payment-outbox-dispatch",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/scheduler-dispatch",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/uptime-monitor",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/intelligence-digest?cadence=daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/intelligence-digest?cadence=weekly",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/intelligence-digest?cadence=monthly",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/intelligence-digest?cadence=partner-weekly",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/retention-enforcement?dryRun=false",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com https://us.i.posthog.com https://us-assets.i.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: https://api.stack-auth.com https://challenges.cloudflare.com https://staging-apiv3.adumoonline.com https://apiv3.adumoonline.com https://us.i.posthog.com https://us-assets.i.posthog.com; frame-src 'self' https://challenges.cloudflare.com; frame-ancestors 'none'; form-action 'self' https://staging-apiv3.adumoonline.com https://apiv3.adumoonline.com; worker-src 'self' blob:"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}
