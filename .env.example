# ============================================================================
# HOTEL ETUNA ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to git.
#
# LOCAL DEV: keep http://localhost:3000 (or :3010 for Playwright) below — correct.
# PRODUCTION: URLs live in Vercel only. Do not paste localhost into Vercel.
#   Push secrets from .env.local with production URL overrides:
#     npm run env:push-vercel
#   Overrides (production): NEXTAUTH_URL, NEXT_PUBLIC_*_URL, ADUMO_REDIRECT_*,
#   ADUMO_WEBHOOK_URL → https://www.hoteletuna.com (see docs/project/PLANNING.md § DNS)

# ============================================================================
# DATABASE (Neon PostgreSQL)
# ============================================================================
# Use the pooled Neon connection string for local development and Vercel.
# Example format only; never commit the real password.
DATABASE_URL=postgresql://username:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://username:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
SINGLE_TENANT_MODE=false
HUB_TENANT_ID=etuna-tenant-uuid
DEFAULT_PROPERTY_ID=etuna-property-uuid

# DB driver: local/CI use node-postgres (default). On Vercel, Neon HTTP is used automatically (VERCEL=1).
# Set only if you need to exercise the Neon HTTP driver locally:
# USE_NEON_HTTP=1
# Optional: use a separate migrated Neon branch for integration tests.
TEST_DATABASE_URL=postgresql://username:password@ep-example-test-pooler.region.aws.neon.tech/neondb?sslmode=require

# ============================================================================
# AUTHENTICATION (NextAuth / Stack Auth)
# ============================================================================
# Local only:
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here
# Guest emails + CORS (defaults to NEXTAUTH_URL / NEXT_PUBLIC_APP_URL in code)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (Vercel — set via env:push-vercel, not in .env.local):
# NEXTAUTH_URL=https://www.hoteletuna.com
# NEXT_PUBLIC_SITE_URL=https://www.hoteletuna.com

# Vercel cron routes: /api/cron/* require Authorization: Bearer $CRON_SECRET
CRON_SECRET=generate-with-openssl-rand-hex-32
# Founder intelligence digest recipients (comma-separated). Default: george@buffr.ai
FOUNDER_DIGEST_EMAIL=george@buffr.ai

# Stack Auth (if using)
STACK_AUTH_PROJECT_ID=your-stack-auth-project-id
STACK_AUTH_API_KEY=your-stack-auth-api-key
NEXT_PUBLIC_STACK_PROJECT_ID=your-stack-auth-project-id
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=your-stack-publishable-client-key
STACK_SECRET_SERVER_KEY=your-stack-secret-server-key

# Production — guest registration & rate limiting (Vercel)
# REDIS_URL=rediss://default:password@host:6379
# RATE_LIMIT_REDIS_REQUIRED=true
# Payment fraud gate: block on evaluator errors (default true in production)
# FRAUD_GATE_FAIL_CLOSED=true
# Cloudflare Turnstile (register bot protection; optional in local dev)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ============================================================================
# PAYMENT GATEWAY - ADUMO ONLINE VIRTUAL (hosted page — preferred, SAQ A)
# ============================================================================
# Virtual form POST: .../product/payment/v1/initialisevirtual
# Test MerchantID: 9BA5008C-08EE-4286-A349-54AF91A621B0
# Test JWT Secret: yglTxLCSMm7PEsfaMszAKf2LSRvM2qVW
# Test ApplicationID (3DS): 23ADADC0-DA2D-4DAC-A128-4845A5D71293

ADUMO_BASE_URL=https://staging-apiv3.adumoonline.com
ADUMO_MERCHANT_UID=9BA5008C-08EE-4286-A349-54AF91A621B0
ADUMO_APPLICATION_UID=23ADADC0-DA2D-4DAC-A128-4845A5D71293
ADUMO_JWT_SECRET=yglTxLCSMm7PEsfaMszAKf2LSRvM2qVW
ADUMO_CURRENCY_CODE=NAD
ADUMO_REDIRECT_SUCCESS_URL=http://localhost:3000/payment/success
ADUMO_REDIRECT_FAIL_URL=http://localhost:3000/payment/failed
ADUMO_WEBHOOK_URL=http://localhost:3000/api/webhooks/adumo
# Optional: HMAC verify Adumo webhook payloads (production)
# ADUMO_WEBHOOK_HMAC_SECRET=
# 3D Secure: handled on Adumo hosted page (test app UID above; OTP test123 / 1234 on ACS)

# Production (must match Adumo portal + public DNS — use same host as NEXTAUTH_URL)
# ADUMO_BASE_URL=https://apiv3.adumoonline.com
# ADUMO_MERCHANT_UID=
# ADUMO_APPLICATION_UID=
# ADUMO_JWT_SECRET=
# ADUMO_REDIRECT_SUCCESS_URL=https://www.hoteletuna.com/payment/success
# ADUMO_REDIRECT_FAIL_URL=https://www.hoteletuna.com/payment/failed
# ADUMO_WEBHOOK_URL=https://www.hoteletuna.com/api/webhooks/adumo

# ============================================================================
# NAMQR (BoN v5.0 desk QR — staff generate + confirm on folio)
# ============================================================================
# Payee alias for Nedbank settlement (see lib/platform/settlement-accounts.ts)
# HOTEL_ETUNA_NAMQR_PAYEE_ID=11000481744@nedbank.na
# Optional: HMAC for signed desk payloads in non-production
# NAMQR_SIGNING_SECRET=change-me-in-production

# Apply all pending SQL on Neon (journal 0003–0037):
#   npm run db:migrate:all
#   npm run test:db:migrations
# Optional consolidated file: npm run db:generate:all-sql → database/all-migrations.sql

# Hospitality (Hotel Etuna — no PEP / no staff FinTech nav by default)
HOSPITALITY_PEP_SCREENING_ENABLED=false
HOSPITALITY_STAFF_COMPLIANCE_NAV=false

# Buffr platform billing (invoiced to Hotel Etuna; card fees accrue per transaction)
BUFFR_CARD_PROCESSING_PERCENT=2.5
BUFFR_CARD_PROCESSING_FIXED_NAD=0
BUFFR_MONTHLY_SUBSCRIPTION_NAD=0

# Buffr NamRA / VAT (platform invoices to Hotel Etuna — see docs/BUFFR_FINANCIAL_SERVICES_PROPOSAL_AND_SLA.md §8)
# Set BUFFR_VAT_REGISTERED=true when Buffr has a NamRA VAT vendor number
BUFFR_VAT_REGISTERED=false
BUFFR_VAT_RATE_PERCENT=15
# BUFFR_VAT_NUMBER=0031148015
# BUFFR_INCOME_TAX_REF=15560644-011

# Hotel Etuna property VAT (guest room, F&B, folio — Client files own NamRA returns)
# NamRA Tax Good Standing Certificate (issued 15 Jan 2026, valid to 15 May 2026)
# Hotel Etuna — Etuna Guesthouse And Tours CC (NamRA good standing 15 Jan 2026)
HOTEL_ETUNA_VAT_REGISTERED=true
HOTEL_ETUNA_CC_NUMBER=CC/2011/3890
HOTEL_ETUNA_VAT_NUMBER=05517026-015
HOTEL_ETUNA_INCOME_TAX_REF=05517026-011
HOTEL_ETUNA_LEGAL_NAME=Etuna Guesthouse And Tours CC
HOTEL_ETUNA_PRICES_VAT_INCLUSIVE=true
HOTEL_ETUNA_VAT_RATE_PERCENT=15
# TIN 05517026 · employee tax 05517026-014 · WHT services 05517026-018 — see lib/platform/namibia-tax.ts

# ============================================================================
# BANK OF NAMIBIA API (PSD-12 Compliance)
# ============================================================================
# Required for automated incident reporting (PSD-12 Section 11.13-11.15)
BON_API_URL=https://api.bon.com.na/v1
BON_API_KEY=your-bon-api-key-here

# ============================================================================
# SMS PROVIDER - TWILIO (PSD-12 2FA Compliance)
# ============================================================================
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+264XXXXXXXXX

# Alternative: AWS SNS
# SMS_PROVIDER=aws_sns
# AWS_SNS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SNS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_SNS_REGION=us-east-1

# ============================================================================
# EMAIL SERVICE
# ============================================================================
# Namecheap PrivateEmail or SMTP
EMAIL_SMTP_HOST=mail.privateemail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=frontdesk@hoteletuna.com
EMAIL_SMTP_PASS=your-email-password
EMAIL_SMTP_SECURE=false
EMAIL_SENDER_EMAIL=frontdesk@hoteletuna.com
EMAIL_SENDER_NAME=Hotel Etuna Concierge
# Optional override for /api/contact (default: route by subject → frontdesk | marketing | support)
# EMAIL_CONTACT_TO=frontdesk@hoteletuna.com
# Team inboxes (lib/copy/brand.ts): frontdesk, marketing, support, admin, founder @hoteletuna.com

# Legacy SMTP aliases are still supported for local compatibility:
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=587
# SMTP_USER=noreply@buffr.ai
# SMTP_PASS=your-email-password
# SMTP_PASSWORD=your-email-password

# Alternative: SendGrid
# SENDGRID_API_KEY=your-sendgrid-api-key

# Alternative: AWS SES
# AWS_SES_ACCESS_KEY_ID=your-aws-access-key
# AWS_SES_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_SES_REGION=us-east-1

# ============================================================================
# ELECTRONIC SIGNATURES (ETA 2019 Compliance)
# ============================================================================
# DocuSign (optional - service supports local signatures)
DOCUSIGN_API_KEY=your-docusign-api-key
DOCUSIGN_ACCOUNT_ID=your-docusign-account-id
DOCUSIGN_BASE_URL=https://demo.docusign.net

# Alternative: Adobe Sign
# ADOBE_SIGN_CLIENT_ID=your-adobe-client-id
# ADOBE_SIGN_CLIENT_SECRET=your-adobe-client-secret

# ============================================================================
# FILE STORAGE
# ============================================================================
# AWS S3
AWS_S3_BUCKET=hotel-etuna-uploads
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=your-aws-access-key
AWS_S3_SECRET_ACCESS_KEY=your-aws-secret-key

# Alternative: Cloudflare R2
# CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-key
# CLOUDFLARE_R2_BUCKET=buffr-host-uploads

# ============================================================================
# MONITORING & ALERTS (PSD-12 Compliance)
# ============================================================================
# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL_ALERTS=#alerts
SLACK_CHANNEL_INCIDENTS=#incidents

# PagerDuty
PAGERDUTY_API_KEY=your-pagerduty-api-key
PAGERDUTY_SERVICE_KEY=your-service-key

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn
SENTRY_ORG=buffr
SENTRY_PROJECT=hotel-etuna

# ============================================================================
# AI/LLM SERVICES
# ============================================================================
# Provider order is cost-first by default: DeepSeek primary, then OpenAI, Anthropic,
# and an optional OpenAI-compatible fallback endpoint.
AI_PROVIDER_ORDER=deepseek,openai,anthropic,llm
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional OpenAI-compatible local/backup provider
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=your-local-or-backup-llm-key
LLM_CHOICE=llama3.2:latest

# Mem0 (Memory)
# Optional cloud mirror — long-term guest memory is stored in Neon (crm_guest_memory_facts)
# MEM0_API_KEY=your-mem0-api-key
RESTAURANT_DEPOSIT_BASE_CENTS=5000
RESTAURANT_DEPOSIT_PER_GUEST_CENTS=2500

# Qdrant (Vector DB for RAG)
RAG_ENABLED=false
RAG_QDRANT_COLLECTION=buffr_rag
# Qdrant Cloud cluster URL (Inference enabled in console). Port :6333 or auto-append.
QDRANT_URL=https://your-cluster-id.us-west-2-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# Qdrant Cloud Inference — embeddings at upsert/query (384d e5-small). Enable Inference in console.
RAG_USE_QDRANT_INFERENCE=true
QDRANT_INFERENCE_MODEL=intfloat/multilingual-e5-small
QDRANT_INFERENCE_DIMENSIONS=384

# Hub tenant UUID — required for `npm run rag:seed` (markdown under data/hotel-etuna-knowledge/)
HUB_TENANT_ID=

# PostHog analytics / product events
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-api-key
# US Cloud ingest (project 341765):
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Redis-compatible cache/session store (optional for production scaling)
REDIS_URL=redis://default:password@host:6379

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Card 3DS: handled on Adumo Virtual hosted page (not an app env flag)

# Auto-settle payments (vs deferred settlement)
AUTO_SETTLE_PAYMENTS=false

# Enable fraud detection
ENABLE_FRAUD_DETECTION=true

# Enable 2FA for payments (mandatory for PSD-12)
ENABLE_2FA_PAYMENTS=true

# ============================================================================
# APP URL (local vs production)
# ============================================================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Playwright auto-starts dev on :3010 — if using that port locally:
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:3010
# NEXTAUTH_URL=http://127.0.0.1:3010

# Production (Vercel only — canonical public site):
# NODE_ENV=production
# NEXT_PUBLIC_APP_URL=https://www.hoteletuna.com
# VERCEL_PRODUCTION_URL=https://www.hoteletuna.com

# Hotel branding
NEXT_PUBLIC_HOTEL_NAME="Hotel Etuna"
NEXT_PUBLIC_HOTEL_DESCRIPTION="Luxury guesthouse in Ongwediva, Namibia - He Takes Care of Us"
NEXT_PUBLIC_HOTEL_PHONE=+26465231177
NEXT_PUBLIC_HOTEL_EMAIL=frontdesk@hoteletuna.com
NEXT_PUBLIC_HOTEL_ADDRESS="5544 Valley of the Leopard Street, Ongwediva, Namibia"

# Guest push notifications (Phase 7)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@hoteletuna.com

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================================================
# COMPLIANCE & SECURITY
# ============================================================================
# PSD-12: Encryption key for sensitive data (AES-256-GCM)
ENCRYPTION_KEY=your-32-character-encryption-key-here-must-be-random

# PSD-12: 99.9% uptime monitoring
UPTIME_CHECK_INTERVAL_MS=30000
UPTIME_CHECK_THRESHOLD=0.999

# PSD-12: Recovery Time Objective (RTO) in seconds
RTO_SECONDS=7200

# PSD-12: Recovery Point Objective (RPO) in seconds
RPO_SECONDS=300

# ============================================================================
# LOCAL TEST ACCOUNTS (passwords in .env.local only — never commit)
# ============================================================================
# After seeding, sign in at http://localhost:3000/login
#
# Platform admin (Buffr Hub):
#   PLATFORM_ADMIN_EMAIL=george@buffr.ai
#   ADMIN_PASSWORD=<your-local-password>
#   Provision: npx tsx scripts/provision-platform-admin.ts --email george@buffr.ai --link-hub
#
# Property owner (hub):
#   admin@hoteletuna.com — seeded by scripts/seed-hotel-etuna.ts (uses ADMIN_PASSWORD)
#
# Partner owners:
#   owner@jayla.nam, owner@aquarius.nam — scripts/seed-partners.ts (PARTNER_SEED_PASSWORD)
#
# Adumo 3DS test OTP on staging ACS: test123 or 1234

# ============================================================================
# NOTES
# ============================================================================
# 1. For local development, copy this file to .env.local
# 2. For production, set these in Vercel → Settings → Environment Variables
# 3. Never commit .env.local to git
# 4. Test credentials are provided for Adumo (staging environment)
# 5. Obtain live credentials from:
#    - Adumo: contact sales@adumoonline.com
#    - Bank of Namibia: contact compliance team
#    - Twilio: sign up at twilio.com
# 6. All PSD compliance features require proper configuration
# 7. 3D Secure is mandatory for card payments (PSD-4)
# 8. 2FA is mandatory for all payments (PSD-12)
